		{
			"name": "Create new post",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Validate the status code 201",
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"// Parse request & response body",
							"var jsonRequest = JSON.parse(pm.request.body.raw);",
							"var jsonResponse = pm.response.json();",
							"",
							"// Check request & response title and body",
							"pm.test(\"Response contains correct title and body\", function(){",
							"    pm.expect(jsonRequest.title).to.equal(jsonResponse.title);",
							"    pm.expect(jsonRequest.body).to.equal(jsonResponse.body);",
							"})",
							"",
							"// Saving the postID in an environment variable",
							"pm.collectionVariables.set(\"post_id\", jsonResponse.id);",
							"console.log(jsonResponse.id);",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
