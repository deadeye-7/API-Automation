		{
			"name": "Get the Authorise Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse response body",
							"var json_response = pm.response.json();",
							"",
							"// Validate response code 200",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"",
							"//Check if the response body is has message property and correct credentials are given",
							"pm.test(\"Correct credentials\", function(){",
							"    pm.expect(json_response).to.have.property(\"token\");",
							"    pm.expect(json_response.reason).to.not.equal(\"Bad credentials\");",
							"})",
							"",
							"// Save the token for future use",
							"pm.collectionVariables.set(\"token\", json_response.token);",
							"console.log(json_response.token);",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\" : \"admin\",\n    \"password\" : \"password123\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
