		{
			"name": "Create a Booking",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse request & response body",
							"var json_request = JSON.parse(pm.request.body.raw);",
							"var json_response = pm.response.json();",
							"",
							"// Validate response code 200",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Compare request & response values",
							"pm.test(\"Response contains the values sent via request\", function(){",
							"    pm.expect(json_response.booking.firstname).to.equal(json_request.firstname);",
							"    pm.expect(json_response.booking.lastname).to.equal(json_request.lastname);",
							"    pm.expect(json_response.booking.totalprice).to.equal(json_request.totalprice);",
							"    pm.expect(json_response.booking.depositpaid).to.equal(json_request.depositpaid);",
							"",
							"    pm.expect(json_response.booking.bookingdates.checkin).to.equal(json_request.bookingdates.checkin);",
							"    pm.expect(json_response.booking.bookingdates.checkout).to.equal(json_request.bookingdates.checkout);",
							"",
							"    pm.expect(json_response.booking.additionalneeds).to.equal(json_request.additionalneeds);",
							"});",
							"",
							"// Save the device id for future use",
							"pm.collectionVariables.set(\"booking_id\", json_response.bookingid);",
							"console.log(json_response.bookingid);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
