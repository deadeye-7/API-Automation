		{
			"name": "Add object",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse request & response body",
							"var json_request = JSON.parse(pm.request.body.raw);",
							"var json_response = pm.response.json();",
							"",
							"// Validate response code 200",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Compare request & response values",
							"pm.test(\"Response contains the values sent via request\", function(){",
							"    pm.expect(json_response.name).to.equal(json_request.name)",
							"    pm.expect(json_response.data.year).to.equal(json_request.data.year);",
							"    pm.expect(json_response.data.price).to.equal(json_request.data.price);",
							"    pm.expect(json_response.data[\"CPU model\"]).to.equal(json_request.data[\"CPU model\"]);",
							"    pm.expect(json_response.data[\"Hard disk size\"]).to.equal(json_request.data[\"Hard disk size\"]);",
							"",
							"});",
							"",
							"// Save the device id for future use",
							"pm.collectionVariables.set(\"device_id\", json_response.id);",
							"console.log(json_response.id);",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
