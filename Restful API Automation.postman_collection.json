		{
			"name": "Delete object",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse response body",
							"var json_response = pm.response.json();",
							"",
							"// Get the value of the collection variable",
							"var device_id = pm.collectionVariables.get(\"device_id\");",
							"",
							"// Validate response code 200",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"//Check if the response body is an empty",
							"pm.test(\"Response message is correct\", function(){",
							"    pm.expect(json_response).to.have.property(\"message\");",
							"    pm.expect(json_response.message).to.equal(`Object with id = ${device_id} has been deleted.`);",
							"})",
							""
						],
